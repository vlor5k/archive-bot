// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  // discord id
  id          String @id @unique
  username    String
  displayname String

  startedArchiving DateTime @default(now())

  messages  Message[]
  reactions Reaction[]
}

model Guild {
  // discord id
  id   String @id @unique
  name String

  startedArchiving DateTime @default(now())

  categories Category[]
  channels   Channel[]
}

model Category {
  // discord id
  id   String @id @unique
  name String

  startedArchiving DateTime @default(now())

  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
}

model Channel {
  // discord id
  id   String @id @unique
  name String

  startedArchiving DateTime @default(now())

  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String

  messages Message[]
}

model Message {
  // discord id
  id String @id @unique

  content    String?
  archivedAt DateTime @default(now())

  author User   @relation(fields: [userId], references: [id])
  userId String

  channel   Channel @relation(fields: [channelId], references: [id])
  channelId String

  reactions   Reaction[]
  attachments Attachment[]
}

model Attachment {
  id        String  @id @unique
  name      String
  message   Message @relation(fields: [messageId], references: [id])
  messageId String
}

model Reaction {
  // incremental id
  id    Int    @id @unique @default(autoincrement())
  emoji String

  message   Message @relation(fields: [messageId], references: [id])
  messageId String

  archivedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model Logins {
  id Int @id @unique @default(autoincrement())
  at DateTime @default(now())
}